# Copy to agent-v2/.env. This file is not read from any legacy Agent directory.
# DATABASE_URL may use the shared platform database. Run the API migration first.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/DATABASE
YAYA_AGENT_V2_API_URL=http://127.0.0.1:8788
# Production: deploy the independent office executable beside API, or set its absolute path.
# YAYA_AGENT_V2_OFFICE_PATH=/opt/yaya/yaya-agent-v2-office
# Generate one random secret, shared by API and Worker; at least 32 bytes.
YAYA_AGENT_V2_WORKER_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
# Keep AUTH_TOKEN_SECRET and YAYA_BYOM_ENCRYPTION_KEY consistent with the platform.
# Never replace the encryption key of existing BYOM routes.
# Independent local Skill runner: executes as the current account, NOT an OS sandbox.
# Optional explicit absolute interpreter paths:
# YAYA_EXECUTION_PYTHON=C:/Python312/python.exe
# YAYA_EXECUTION_NODE=C:/Program Files/nodejs/node.exe
# YAYA_EXECUTION_SHELL=C:/Program Files/PowerShell/7/pwsh.exe
# YAYA_AGENT_V2_EXECUTION_URL=http://127.0.0.1:8791
# YAYA_EXECUTION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES

# Model context configuration is server-owned. Conservative UTF-8 byte estimation.
YAYA_AGENT_V2_CONTEXT_TOKENS=32768
# Optional per-BYOM-route context windows, keyed by route ID (JSON).
# YAYA_AGENT_V2_CONTEXT_WINDOWS_JSON={"route-id":65536}
# No task-level duration, model-request or step cap. Legacy MAX_STEPS is ignored.
# Script invocation: timeoutSeconds 1..7200, default 600.
