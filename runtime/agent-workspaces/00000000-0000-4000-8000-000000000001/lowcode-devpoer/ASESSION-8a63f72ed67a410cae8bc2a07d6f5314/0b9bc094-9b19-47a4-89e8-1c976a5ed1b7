```typescript
// agent/src/index.ts
import { Context, Service } from 'cordis'

// 1. 定义 MediaService - 封装 Rust API 调用
class MediaService extends Service {
  constructor(ctx: Context, private apiBase: string) {
    super(ctx, 'media')
  }
  
  // 导入媒体数据
  async importMedia(data: { title: string; type: string; source: string }) {
    const response = await fetch(`${this.apiBase}/api/media/import`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
    return response.json()
  }
  
  // 搜索媒体
  async search(query: string) {
    const response = await fetch(`${this.apiBase}/api/media/search?q=${encodeURIComponent(query)}`)
    return response.json()
  }
}

// 2. 定义同步插件
export const bilibiliSyncPlugin = {
  name: 'bilibili-sync',
  inject: ['media'],  // 声明依赖 MediaService
  apply(ctx: Context) {
    ctx.on('bilibili.sync.request', async (data) => {
      // 1. 调用 B站 API 抓取数据
      const biliData = await fetchBilibiliFavorites(data.userId)
      
      // 2. 通过 MediaService 导入到 Rust 后端
      for (const item of biliData) {
        await ctx.media.importMedia({
          title: item.title,
          type: 'video',
          source: `bilibili:${item.id}`
        })
      }
      
      // 3. 触发事件通知其他插件
      ctx.emit('sync.completed', { source: 'bilibili', count: biliData.length })
    })
  }
}

// 3. 启动 Cordis 应用
const app = new Cordis()
app.plugin(MediaService, { apiBase: process.env.RUST_API_URL })
app.plugin(bilibiliSyncPlugin)
app.start()
```

