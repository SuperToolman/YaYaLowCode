FROM rust:1.94-bookworm AS openapi-build
WORKDIR /workspace
COPY api ./api
RUN cargo run --manifest-path api/Cargo.toml -- --export-openapi

FROM node:22-bookworm-slim AS build
WORKDIR /workspace/web
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web ./
COPY --from=openapi-build /workspace/api/openapi/openapi.json /workspace/api/openapi/openapi.json
RUN pnpm codegen:api
RUN pnpm build

FROM node:22-bookworm-slim
WORKDIR /app/web
ENV NODE_ENV=production PORT=8787
RUN corepack enable
COPY --from=build /workspace/web ./
RUN pnpm install --prod --frozen-lockfile
EXPOSE 8787
CMD ["pnpm", "start"]
