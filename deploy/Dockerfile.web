FROM rust:1.94-bookworm AS openapi-build
WORKDIR /workspace
COPY api ./api
RUN cargo run --manifest-path api/Cargo.toml -- --export-openapi

FROM node:22-bookworm-slim AS build
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY web/package.json ./web/package.json
RUN pnpm install --frozen-lockfile
COPY web ./web
COPY --from=openapi-build /workspace/api/openapi/openapi.json ./api/openapi/openapi.json
RUN pnpm --dir web codegen:api
RUN pnpm --dir web build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=8787
RUN corepack enable
COPY --from=build /workspace/package.json /workspace/pnpm-lock.yaml /workspace/pnpm-workspace.yaml ./
COPY --from=build /workspace/web ./web
RUN pnpm install --prod --frozen-lockfile
WORKDIR /app/web
EXPOSE 8787
CMD ["pnpm", "start"]
