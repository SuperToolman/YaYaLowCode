# syntax=docker/dockerfile:1.7
FROM rust:1.94-bookworm AS api-build
ARG CARGO_REGISTRIES_CRATES_IO_INDEX
RUN if [ -n "$CARGO_REGISTRIES_CRATES_IO_INDEX" ]; then \
      mkdir -p /usr/local/cargo && \
      printf '[source.crates-io]\nreplace-with = "deployment-mirror"\n\n[source.deployment-mirror]\nregistry = "%s"\n' "$CARGO_REGISTRIES_CRATES_IO_INDEX" > /usr/local/cargo/config.toml; \
    fi
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY api ./api
COPY agent-v2/Cargo.toml agent-v2/Cargo.lock ./agent-v2/
COPY agent-v2/core ./agent-v2/core
COPY agent-v2/worker ./agent-v2/worker
COPY agent-v2/office ./agent-v2/office
COPY agent-v2/executor ./agent-v2/executor
RUN --mount=type=cache,id=yaya-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=yaya-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=yaya-cargo-target,target=/workspace/api/target \
    set -eu; \
    cargo build --release --verbose --manifest-path api/Cargo.toml & cargo_pid=$!; \
    while kill -0 "$cargo_pid" 2>/dev/null; do \
      echo "Cargo release build is still running..."; \
      sleep 30; \
    done; \
    wait "$cargo_pid"; \
    cp /workspace/api/target/release/yaya-api /workspace/yaya-api; \
    CARGO_TARGET_DIR=/workspace/api/target cargo build --release --locked --manifest-path agent-v2/Cargo.toml -p yaya-agent-v2-office -p yaya-agent-v2-worker -p yaya-agent-v2-executor; \
    cp /workspace/api/target/release/yaya-agent-v2-office /workspace/yaya-agent-v2-office; \
    cp /workspace/api/target/release/yaya-agent-v2-worker /workspace/yaya-agent-v2-worker; \
    cp /workspace/api/target/release/yaya-agent-v2-executor /workspace/yaya-agent-v2-executor
RUN /workspace/yaya-api --export-openapi

FROM node:24-bookworm-slim AS web-build
ARG NEXT_PUBLIC_BACKEND_WS_URL
ENV NEXT_PUBLIC_BACKEND_WS_URL=${NEXT_PUBLIC_BACKEND_WS_URL}
WORKDIR /workspace/web
RUN corepack enable
RUN corepack prepare pnpm@11.1.2 --activate
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web ./
COPY --from=api-build /workspace/api/openapi/openapi.json /workspace/api/openapi/openapi.json
RUN pnpm codegen:api
RUN pnpm build

FROM node:24-bookworm-slim AS cordis-runtime
WORKDIR /workspace/cordis-host
COPY agent-v2/cordis-host/package.json agent-v2/cordis-host/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY agent-v2/cordis-host/src ./src

FROM web-build AS web-runtime
RUN rm -rf /workspace/web/node_modules

FROM valkey/valkey:8.1-bookworm AS valkey-build

FROM node:24-bookworm-slim
ARG DEBIAN_MIRROR=http://mirrors.aliyun.com/debian
ARG DEBIAN_SECURITY_MIRROR=http://mirrors.aliyun.com/debian-security
ENV NODE_ENV=production \
    PATH="/usr/lib/postgresql/15/bin:${PATH}"
RUN sed -i "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g; s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl openssl postgresql postgresql-client supervisor util-linux python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --uid 10001 yaya
WORKDIR /app
RUN corepack enable
RUN corepack prepare pnpm@11.1.2 --activate
COPY --from=web-build /workspace/web/package.json /workspace/web/pnpm-lock.yaml /workspace/web/pnpm-workspace.yaml ./web/
RUN chown yaya:yaya /app /app/web /home/yaya
USER yaya
RUN --mount=type=cache,id=yaya-pnpm-store,target=/home/yaya/.local/share/pnpm/store \
    corepack pnpm@11.1.2 --dir /app/web install --prod --frozen-lockfile
USER root
COPY --chown=yaya:yaya --from=web-runtime /workspace/web ./web
COPY --chown=yaya:yaya CHANGELOG.md ./CHANGELOG.md
COPY --chown=yaya:yaya --from=cordis-runtime /workspace/cordis-host ./agent-v2/cordis-host
COPY --from=api-build /workspace/yaya-api /usr/local/bin/yaya-api
COPY --from=api-build /workspace/yaya-agent-v2-office /usr/local/bin/yaya-agent-v2-office
COPY --from=api-build /workspace/yaya-agent-v2-worker /usr/local/bin/yaya-agent-v2-worker
COPY --from=api-build /workspace/yaya-agent-v2-executor /usr/local/bin/yaya-agent-v2-executor
COPY --from=valkey-build /usr/local/bin/valkey-server /usr/local/bin/valkey-server
COPY deploy/supervisord.single.conf /etc/supervisor/conf.d/yaya.conf
COPY deploy/entrypoint-single.sh /usr/local/bin/yaya-entrypoint
RUN sed -i 's/\r$//' /usr/local/bin/yaya-entrypoint && chmod 755 /usr/local/bin/yaya-entrypoint
WORKDIR /var/lib/yaya
EXPOSE 8787 8788
ENTRYPOINT ["/usr/local/bin/yaya-entrypoint"]
