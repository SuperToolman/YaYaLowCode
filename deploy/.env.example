
# PostgreSQL
POSTGRES_DB=yaya_low_code
POSTGRES_USER=yaya
POSTGRES_PASSWORD=replace-with-a-random-password

# Valkey cache
VALKEY_PASSWORD=replace-with-a-random-password
VALKEY_CACHE_TTL_HOURS=8

# Rust build dependency registry (use an accessible mirror for your region)
CARGO_REGISTRIES_CRATES_IO_INDEX=sparse+https://rsproxy.cn/index/
DEBIAN_MIRROR=http://mirrors.aliyun.com/debian
DEBIAN_SECURITY_MIRROR=http://mirrors.aliyun.com/debian-security

# Application secrets
AUTH_TOKEN_SECRET=replace-with-a-random-32-byte-secret
BACKEND_INTERNAL_TOKEN=replace-with-a-different-random-32-byte-secret
YAYA_AGENT_V2_WORKER_SECRET=replace-with-a-random-32-byte-worker-secret
YAYA_AGENT_V2_MAX_COMPLETION_TOKENS=8192
# Optional separate internal Skill runner credential; defaults to the Worker credential.
# YAYA_EXECUTION_SECRET=replace-with-a-different-random-32-byte-secret
# Alibaba Cloud SMS login credentials
ALIYUN_ACCESS_KEY_ID=replace-with-aliyun-access-key-id
ALIYUN_ACCESS_KEY_SECRET=replace-with-aliyun-access-key-secret
# Exact approved signature.
ALIYUN_SMS_SIGN_NAME=深圳兆元信息技术
ALIYUN_SMS_LOGIN_TEMPLATE_CODE=SMS_276325873
# Must match the variable name in the approved template (${code} by default).
ALIYUN_SMS_CODE_PARAM=code
ALIYUN_SMS_REGION=cn-hangzhou
# Base64-encoded 32-byte AES key used to encrypt model provider API keys and user SMTP authorization codes.
YAYA_BYOM_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key
# Set false only while accessing the platform over plain HTTP. Use true behind HTTPS.
AUTH_COOKIE_SECURE=false
# Comma-separated browser origins for direct API access. Leave blank for development.
CORS_ALLOWED_ORIGINS=

# Host ports
CONTAINER_NAME=yaya
WEB_PORT=8787
API_PORT=8788

# Optional public WebSocket URL. Leave blank to derive it from the browser origin
# (local 8787 -> 8788 and single-container 8787 -> 8788), using ws:// or wss:// accordingly.
NEXT_PUBLIC_BACKEND_WS_URL=
